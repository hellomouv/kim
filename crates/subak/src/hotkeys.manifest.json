{
  "schema": "kim.hotkey-manifest",
  "schema_version": 1,
  "hotkey_contract": 1,
  "tool": "subak",
  "version": "0.0.1",
  "backend": "register",
  "contexts": [
    { "id": "terminal", "title": "Terminal pane", "passthrough": true },
    { "id": "copy-mode", "title": "Copy mode" },
    { "id": "manager", "title": "Terminal manager" }
  ],
  "leaders": [
    { "id": "prefix", "title": "Prefix key (tmux C-b)", "default": "Ctrl+B" }
  ],
  "actions": [
    { "id": "terminal.new", "title": "New Terminal", "scopes": ["app"], "defaults": ["Ctrl+T"] },
    { "id": "terminal.close", "title": "Close Terminal (kills it; confirms when busy)", "scopes": ["app"], "defaults": ["Ctrl+W"], "destructive": true },
    { "id": "tab.next", "title": "Next Terminal tab", "scopes": ["app"], "defaults": ["Ctrl+Tab"] },
    { "id": "tab.previous", "title": "Previous Terminal tab", "scopes": ["app"], "defaults": ["Ctrl+Shift+Tab"] },
    { "id": "tab.hide", "title": "Hide tab (the Terminal keeps running)", "scopes": ["app"], "defaults": [] },
    { "id": "tab.move-left", "title": "Move tab left", "scopes": ["app"], "defaults": [] },
    { "id": "tab.move-right", "title": "Move tab right", "scopes": ["app"], "defaults": [] },
    { "id": "help.show", "title": "Show keyboard shortcuts", "scopes": ["app"], "defaults": ["F1", "@prefix char:?"] },
    { "id": "input.send-prefix", "title": "Send the prefix key to the program", "scopes": ["app"], "defaults": ["@prefix @prefix"] },
    { "id": "window.new", "title": "New window", "scopes": ["app"], "defaults": ["@prefix char:c"] },
    { "id": "window.next", "title": "Next window", "scopes": ["app"], "defaults": ["@prefix char:n"] },
    { "id": "window.previous", "title": "Previous window", "scopes": ["app"], "defaults": ["@prefix char:p"] },
    { "id": "window.select-0", "title": "Select window 0", "scopes": ["app"], "defaults": ["@prefix 0"] },
    { "id": "window.select-1", "title": "Select window 1", "scopes": ["app"], "defaults": ["@prefix 1"] },
    { "id": "window.select-2", "title": "Select window 2", "scopes": ["app"], "defaults": ["@prefix 2"] },
    { "id": "window.select-3", "title": "Select window 3", "scopes": ["app"], "defaults": ["@prefix 3"] },
    { "id": "window.select-4", "title": "Select window 4", "scopes": ["app"], "defaults": ["@prefix 4"] },
    { "id": "window.select-5", "title": "Select window 5", "scopes": ["app"], "defaults": ["@prefix 5"] },
    { "id": "window.select-6", "title": "Select window 6", "scopes": ["app"], "defaults": ["@prefix 6"] },
    { "id": "window.select-7", "title": "Select window 7", "scopes": ["app"], "defaults": ["@prefix 7"] },
    { "id": "window.select-8", "title": "Select window 8", "scopes": ["app"], "defaults": ["@prefix 8"] },
    { "id": "window.select-9", "title": "Select window 9", "scopes": ["app"], "defaults": ["@prefix 9"] },
    { "id": "window.rename", "title": "Rename window", "scopes": ["app"], "defaults": ["@prefix char:,"] },
    { "id": "window.kill", "title": "Kill window (confirms)", "scopes": ["app"], "defaults": ["@prefix char:&"], "destructive": true },
    { "id": "pane.split-right", "title": "Split pane left/right", "scopes": ["app"], "defaults": ["@prefix char:%", "Alt+Shift+Plus"] },
    { "id": "pane.split-down", "title": "Split pane top/bottom", "scopes": ["app"], "defaults": ["@prefix char:\"", "Alt+Shift+Minus"] },
    { "id": "pane.focus-up", "title": "Focus pane above", "scopes": ["app"], "defaults": ["@prefix Up", "Alt+Up"] },
    { "id": "pane.focus-down", "title": "Focus pane below", "scopes": ["app"], "defaults": ["@prefix Down", "Alt+Down"] },
    { "id": "pane.focus-left", "title": "Focus pane on the left", "scopes": ["app"], "defaults": ["@prefix Left", "Alt+Left"] },
    { "id": "pane.focus-right", "title": "Focus pane on the right", "scopes": ["app"], "defaults": ["@prefix Right", "Alt+Right"] },
    { "id": "pane.resize-up", "title": "Resize pane up", "scopes": ["app"], "defaults": [{ "keys": "@prefix Ctrl+Up", "repeat": true }, { "keys": "Alt+Shift+Up", "repeat": true }] },
    { "id": "pane.resize-down", "title": "Resize pane down", "scopes": ["app"], "defaults": [{ "keys": "@prefix Ctrl+Down", "repeat": true }, { "keys": "Alt+Shift+Down", "repeat": true }] },
    { "id": "pane.resize-left", "title": "Resize pane left", "scopes": ["app"], "defaults": [{ "keys": "@prefix Ctrl+Left", "repeat": true }, { "keys": "Alt+Shift+Left", "repeat": true }] },
    { "id": "pane.resize-right", "title": "Resize pane right", "scopes": ["app"], "defaults": [{ "keys": "@prefix Ctrl+Right", "repeat": true }, { "keys": "Alt+Shift+Right", "repeat": true }] },
    { "id": "pane.zoom", "title": "Zoom pane", "scopes": ["app"], "defaults": ["@prefix char:z", "Ctrl+Shift+Z"] },
    { "id": "pane.kill", "title": "Kill pane (confirms)", "scopes": ["app"], "defaults": ["@prefix char:x"], "destructive": true },
    { "id": "pane.next", "title": "Focus the next pane", "scopes": ["app"], "defaults": ["@prefix char:o"] },
    { "id": "pane.swap-previous", "title": "Swap with the previous pane", "scopes": ["app"], "defaults": ["@prefix char:{"] },
    { "id": "pane.swap-next", "title": "Swap with the next pane", "scopes": ["app"], "defaults": ["@prefix char:}"] },
    { "id": "window.rotate", "title": "Rotate the panes forwards", "scopes": ["app"], "defaults": ["@prefix Ctrl+O"] },
    { "id": "window.rotate-back", "title": "Rotate the panes backwards", "scopes": ["app"], "defaults": ["@prefix Alt+O"] },
    { "id": "layout.even-horizontal", "title": "Arrange the panes side by side", "scopes": ["app"], "defaults": ["@prefix Alt+1"] },
    { "id": "layout.even-vertical", "title": "Arrange the panes stacked", "scopes": ["app"], "defaults": ["@prefix Alt+2"] },
    { "id": "layout.tiled", "title": "Arrange the panes tiled", "scopes": ["app"], "defaults": ["@prefix Alt+5"] },
    { "id": "terminal.new-from", "title": "New Terminal from a profile (menu)", "scopes": ["app"], "defaults": ["@prefix char:N"] },
    { "id": "layout.main-horizontal-mirrored", "title": "Arrange the panes: the main pane at the bottom", "scopes": ["app"], "defaults": ["@prefix Alt+6"] },
    { "id": "layout.main-vertical-mirrored", "title": "Arrange the panes: the main pane on the right", "scopes": ["app"], "defaults": ["@prefix Alt+7"] },
    { "id": "layout.spread", "title": "Spread the panes out evenly", "scopes": ["app"], "defaults": ["@prefix char:E"] },
    { "id": "window.info", "title": "Show where you are (display-message)", "scopes": ["app"], "defaults": ["@prefix char:i"] },
    { "id": "layout.main-horizontal", "title": "Arrange the panes: the main pane on top", "scopes": ["app"], "defaults": ["@prefix Alt+3"] },
    { "id": "layout.main-vertical", "title": "Arrange the panes: the main pane on the left", "scopes": ["app"], "defaults": ["@prefix Alt+4"] },
    { "id": "layout.next", "title": "Next layout preset", "scopes": ["app"], "defaults": ["@prefix Space"] },
    { "id": "window.last", "title": "Go to the previous window", "scopes": ["app"], "defaults": ["@prefix char:l"] },
    { "id": "pane.last", "title": "Go to the previous pane", "scopes": ["app"], "defaults": ["@prefix char:;"] },
    { "id": "pane.resize-up-5", "title": "Resize pane up by 5", "scopes": ["app"], "defaults": [{ "keys": "@prefix Alt+Up", "repeat": true }] },
    { "id": "pane.resize-down-5", "title": "Resize pane down by 5", "scopes": ["app"], "defaults": [{ "keys": "@prefix Alt+Down", "repeat": true }] },
    { "id": "pane.resize-left-5", "title": "Resize pane left by 5", "scopes": ["app"], "defaults": [{ "keys": "@prefix Alt+Left", "repeat": true }] },
    { "id": "pane.resize-right-5", "title": "Resize pane right by 5", "scopes": ["app"], "defaults": [{ "keys": "@prefix Alt+Right", "repeat": true }] },
    { "id": "view.refresh", "title": "Redraw the window", "scopes": ["app"], "defaults": ["@prefix char:r"] },
    { "id": "command.prompt", "title": "Command prompt (tmux commands)", "scopes": ["app"], "defaults": ["@prefix char::"] },
    { "id": "copy.enter", "title": "Enter copy mode", "scopes": ["app"], "defaults": ["@prefix char:["] },
    { "id": "buffer.paste", "title": "Paste the latest buffer", "scopes": ["app"], "defaults": ["@prefix char:]"] },
    { "id": "pane.break", "title": "Break the pane out into a window of its own", "scopes": ["app"], "defaults": ["@prefix char:!"] },
    { "id": "buffer.list", "title": "List the paste buffers", "scopes": ["app"], "defaults": ["@prefix char:#"] },
    { "id": "buffer.delete", "title": "Delete the latest paste buffer", "scopes": ["app"], "defaults": ["@prefix char:-"] },
    { "id": "copy.page-up", "title": "Copy mode, one page up", "scopes": ["app"], "defaults": ["@prefix PageUp"] },
    { "id": "client.detach", "title": "Detach this client (processes keep running)", "scopes": ["app"], "defaults": ["@prefix char:d"] },
    { "id": "terminal.rename", "title": "Rename Terminal", "scopes": ["app"], "defaults": ["Ctrl+Shift+R", "@prefix char:$"] },
    { "id": "gui.show", "title": "Show Subak", "scopes": ["global"], "defaults": [] },
    { "id": "clipboard.copy", "title": "Copy the selection", "context": "terminal", "defaults": ["Ctrl+Shift+C", "Ctrl+Insert"] },
    { "id": "clipboard.paste", "title": "Paste", "context": "terminal", "defaults": ["Ctrl+Shift+V", "Shift+Insert"] },
    { "id": "clipboard.copy-html", "title": "Copy the selection with colours (plain text and HTML)", "context": "terminal", "defaults": [] },
    { "id": "clipboard.paste-one-line", "title": "Paste as one line (line breaks become spaces)", "context": "terminal", "defaults": [] },
    { "id": "selection.all", "title": "Select all output", "context": "terminal", "defaults": ["Ctrl+Shift+A"] },
    { "id": "selection.mark", "title": "Select with the keyboard (mark mode)", "context": "terminal", "defaults": ["Ctrl+Shift+M"] },
    { "id": "search.open", "title": "Find in the output", "context": "terminal", "defaults": ["Ctrl+Shift+F"] },
    { "id": "output.save", "title": "Save the output to a file (asks first)", "context": "terminal", "defaults": [] },
    { "id": "view.zoom-in", "title": "Larger text", "context": "terminal", "defaults": ["Ctrl+Plus", "Ctrl+NumpadAdd"] },
    { "id": "view.zoom-out", "title": "Smaller text", "context": "terminal", "defaults": ["Ctrl+Minus", "Ctrl+NumpadSubtract"] },
    { "id": "view.zoom-reset", "title": "Default text size", "context": "terminal", "defaults": ["Ctrl+0", "Ctrl+Numpad0"] },
    { "id": "scroll.page-up", "title": "Scroll one page back", "context": "terminal", "defaults": ["Ctrl+Shift+PageUp"] },
    { "id": "scroll.page-down", "title": "Scroll one page forward", "context": "terminal", "defaults": ["Ctrl+Shift+PageDown"] },
    { "id": "scroll.line-up", "title": "Scroll one line back", "context": "terminal", "defaults": ["Ctrl+Shift+Up"] },
    { "id": "scroll.line-down", "title": "Scroll one line forward", "context": "terminal", "defaults": ["Ctrl+Shift+Down"] },
    { "id": "scroll.top", "title": "Scroll to the oldest line", "context": "terminal", "defaults": ["Ctrl+Shift+Home"] },
    { "id": "scroll.bottom", "title": "Scroll to the live screen", "context": "terminal", "defaults": ["Ctrl+Shift+End"] },
    { "id": "copy.exit", "title": "Leave copy mode", "context": "copy-mode", "defaults": ["char:q", "Escape"] },
    { "id": "copy.begin-selection", "title": "Begin selection", "context": "copy-mode", "defaults": ["Space"] },
    { "id": "copy.copy-selection", "title": "Copy the selection and leave copy mode", "context": "copy-mode", "defaults": ["Enter"] },
    { "id": "manager.open", "title": "Open the selected Terminal in its window", "context": "manager", "defaults": ["Enter"] },
    { "id": "manager.new", "title": "New Terminal (opens it)", "context": "manager", "defaults": ["Ctrl+N"] },
    { "id": "manager.rename", "title": "Rename the selected Terminal", "context": "manager", "defaults": ["F2"] },
    { "id": "manager.delete", "title": "Delete the selected Terminal (asks first)", "context": "manager", "defaults": ["Delete"], "destructive": true },
    { "id": "manager.search", "title": "Search Terminals", "context": "manager", "defaults": ["Ctrl+F", "char:/"] },
    { "id": "manager.pin", "title": "Keep the manager open (pin)", "context": "manager", "defaults": ["Ctrl+P"] },
    { "id": "manager.close", "title": "Close the manager (Terminals keep running)", "context": "manager", "defaults": ["Escape"] },
    { "id": "terminal.insert-newline", "title": "Insert a new line without running it", "context": "terminal", "defaults": ["Alt+Shift+Enter"] },
    { "id": "line.home", "title": "Line editing: to the start of the line", "context": "terminal", "defaults": [] },
    { "id": "line.end", "title": "Line editing: to the end of the line", "context": "terminal", "defaults": [] },
    { "id": "line.previous-word", "title": "Line editing: one word back", "context": "terminal", "defaults": [] },
    { "id": "line.next-word", "title": "Line editing: one word forward", "context": "terminal", "defaults": [] },
    { "id": "line.delete-previous-word", "title": "Line editing: delete the previous word", "context": "terminal", "defaults": [] },
    { "id": "line.delete-line", "title": "Line editing: delete the whole line", "context": "terminal", "defaults": [] }
  ]
}
