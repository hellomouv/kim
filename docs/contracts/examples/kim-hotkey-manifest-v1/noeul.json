{
  "schema": "kim.hotkey-manifest",
  "schema_version": 1,
  "hotkey_contract": 1,
  "tool": "noeul",
  "version": "0.1.0",
  "backend": "register",
  "contexts": [
    { "id": "capture-overlay", "title": "Region capture overlay" },
    { "id": "annotate", "title": "Annotation tool (in the overlay or on a pin)" },
    { "id": "pin", "title": "Floating pinned image" }
  ],
  "actions": [
    { "id": "capture.region", "title": "Capture a region", "scopes": ["global", "app"], "defaults": ["F1"] },
    { "id": "paste.float", "title": "Pin the clipboard", "scopes": ["global", "app"], "defaults": ["F3"] },
    { "id": "settings.open", "title": "Open settings", "scopes": ["app"], "defaults": ["Ctrl+Comma"] },
    { "id": "pins.clickable", "title": "Make every pin clickable again (after click-through)", "scopes": ["global", "app"], "defaults": [] },
    { "id": "pins.toggle-hidden", "title": "Hide all pins, or show them again", "scopes": ["global", "app"], "defaults": [] },
    { "id": "capture.monitor", "title": "Capture the monitor under the pointer and pin it", "scopes": ["global", "app"], "defaults": [] },
    { "id": "capture.window", "title": "Capture the active window and pin it", "scopes": ["global", "app"], "defaults": [] },

    { "id": "capture.pin", "title": "Pin the selection (keyboard twin of double-click inside)", "context": "capture-overlay", "defaults": ["Enter"] },
    { "id": "capture.copy", "title": "Copy the selection", "context": "capture-overlay", "defaults": ["Ctrl+C"] },
    { "id": "capture.save", "title": "Save the selection", "context": "capture-overlay", "defaults": ["Ctrl+S"] },
    { "id": "capture.quick-save", "title": "Quick-save the selection", "context": "capture-overlay", "defaults": ["Ctrl+Shift+S"] },
    { "id": "capture.cancel", "title": "Cancel the capture", "context": "capture-overlay", "defaults": ["Escape"] },
    { "id": "capture.private", "title": "Mark this capture private (kept in no history)", "context": "capture-overlay", "defaults": ["P"] },
    { "id": "selection.mark", "title": "Mark a corner at the pointer (keyboard selection)", "context": "capture-overlay", "defaults": ["Space"] },
    { "id": "selection.full", "title": "Select the monitor, then all monitors", "context": "capture-overlay", "defaults": ["Ctrl+A"] },
    { "id": "selection.last", "title": "Select the last captured rectangle", "context": "capture-overlay", "defaults": ["R"] },
    { "id": "selection.move-up", "title": "Move the selection up one pixel", "context": "capture-overlay", "defaults": [{ "keys": "Up", "repeat": true }] },
    { "id": "selection.move-down", "title": "Move the selection down one pixel", "context": "capture-overlay", "defaults": [{ "keys": "Down", "repeat": true }] },
    { "id": "selection.move-left", "title": "Move the selection left one pixel", "context": "capture-overlay", "defaults": [{ "keys": "Left", "repeat": true }] },
    { "id": "selection.move-right", "title": "Move the selection right one pixel", "context": "capture-overlay", "defaults": [{ "keys": "Right", "repeat": true }] },
    { "id": "selection.grow-up", "title": "Grow the top edge one pixel", "context": "capture-overlay", "defaults": [{ "keys": "Ctrl+Up", "repeat": true }] },
    { "id": "selection.grow-down", "title": "Grow the bottom edge one pixel", "context": "capture-overlay", "defaults": [{ "keys": "Ctrl+Down", "repeat": true }] },
    { "id": "selection.grow-left", "title": "Grow the left edge one pixel", "context": "capture-overlay", "defaults": [{ "keys": "Ctrl+Left", "repeat": true }] },
    { "id": "selection.grow-right", "title": "Grow the right edge one pixel", "context": "capture-overlay", "defaults": [{ "keys": "Ctrl+Right", "repeat": true }] },
    { "id": "selection.shrink-up", "title": "Shrink from the bottom edge one pixel", "context": "capture-overlay", "defaults": [{ "keys": "Shift+Up", "repeat": true }] },
    { "id": "selection.shrink-down", "title": "Shrink from the top edge one pixel", "context": "capture-overlay", "defaults": [{ "keys": "Shift+Down", "repeat": true }] },
    { "id": "selection.shrink-left", "title": "Shrink from the right edge one pixel", "context": "capture-overlay", "defaults": [{ "keys": "Shift+Left", "repeat": true }] },
    { "id": "selection.shrink-right", "title": "Shrink from the left edge one pixel", "context": "capture-overlay", "defaults": [{ "keys": "Shift+Right", "repeat": true }] },
    { "id": "pointer.move-up", "title": "Move the pointer up one pixel", "context": "capture-overlay", "defaults": [{ "keys": "code:KeyW", "repeat": true }] },
    { "id": "pointer.move-down", "title": "Move the pointer down one pixel", "context": "capture-overlay", "defaults": [{ "keys": "code:KeyS", "repeat": true }] },
    { "id": "pointer.move-left", "title": "Move the pointer left one pixel", "context": "capture-overlay", "defaults": [{ "keys": "code:KeyA", "repeat": true }] },
    { "id": "pointer.move-right", "title": "Move the pointer right one pixel", "context": "capture-overlay", "defaults": [{ "keys": "code:KeyD", "repeat": true }] },
    { "id": "detect.cycle", "title": "Detect windows, UI elements, or nothing", "context": "capture-overlay", "defaults": ["E"] },
    { "id": "magnifier.toggle", "title": "Show or hide the magnifier", "context": "capture-overlay", "defaults": ["M"] },
    { "id": "color.copy", "title": "Copy the color under the pointer", "context": "capture-overlay", "defaults": ["C"] },
    { "id": "color.format-next", "title": "Switch the color format (HEX, RGB, HSL)", "context": "capture-overlay", "defaults": ["Shift+C"] },
    { "id": "history.previous", "title": "Previous captured rectangle", "context": "capture-overlay", "defaults": ["Comma"] },
    { "id": "history.next", "title": "Next captured rectangle", "context": "capture-overlay", "defaults": ["Period"] },

    { "id": "annotate.done", "title": "Leave the tool and keep the drawing", "context": "annotate", "defaults": ["Escape"] },
    { "id": "annotate.undo", "title": "Undo", "context": "annotate", "defaults": ["Ctrl+Z"] },
    { "id": "annotate.redo", "title": "Redo", "context": "annotate", "defaults": ["Ctrl+Y", "Ctrl+Shift+Z"] },
    { "id": "annotate.width-down", "title": "Thinner line", "context": "annotate", "defaults": [{ "keys": "char:[", "repeat": true }] },
    { "id": "annotate.width-up", "title": "Thicker line", "context": "annotate", "defaults": [{ "keys": "char:]", "repeat": true }] },
    { "id": "annotate.rectangle", "title": "Rectangle tool", "context": "annotate", "defaults": [] },
    { "id": "annotate.ellipse", "title": "Ellipse tool", "context": "annotate", "defaults": [] },
    { "id": "annotate.line", "title": "Line tool", "context": "annotate", "defaults": [] },
    { "id": "annotate.arrow", "title": "Arrow tool", "context": "annotate", "defaults": [] },
    { "id": "annotate.pen", "title": "Pen tool", "context": "annotate", "defaults": [] },
    { "id": "annotate.marker", "title": "Marker tool", "context": "annotate", "defaults": [] },
    { "id": "annotate.text", "title": "Text tool", "context": "annotate", "defaults": [] },
    { "id": "annotate.mosaic", "title": "Mosaic tool", "context": "annotate", "defaults": [] },
    { "id": "annotate.blur", "title": "Blur tool", "context": "annotate", "defaults": [] },
    { "id": "annotate.eraser", "title": "Eraser tool", "context": "annotate", "defaults": [] },
    { "id": "annotate.redact", "title": "Solid redaction tool (irreversible on export)", "context": "annotate", "defaults": [] },
    { "id": "annotate.clear-all", "title": "Remove all annotations (can be undone)", "context": "annotate", "defaults": [] },
    { "id": "annotate.delete", "title": "Delete the selected annotation", "context": "annotate", "defaults": ["Delete"] },
    { "id": "annotate.select-next", "title": "Select the next annotation", "context": "annotate", "defaults": ["N"] },
    { "id": "annotate.select-previous", "title": "Select the previous annotation", "context": "annotate", "defaults": ["Shift+N"] },
    { "id": "annotate.bring-forward", "title": "Bring the selected annotation forward", "context": "annotate", "defaults": ["PageUp"] },
    { "id": "annotate.send-backward", "title": "Send the selected annotation backward", "context": "annotate", "defaults": ["PageDown"] },
    { "id": "annotate.bring-to-front", "title": "Bring the selected annotation to the front", "context": "annotate", "defaults": ["Shift+PageUp"] },
    { "id": "annotate.send-to-back", "title": "Send the selected annotation to the back", "context": "annotate", "defaults": ["Shift+PageDown"] },

    { "id": "pin.close", "title": "Close the pin (can be reopened)", "context": "pin", "defaults": ["Escape", "Ctrl+W"] },
    { "id": "pin.destroy", "title": "Destroy the pin (cannot be reopened)", "context": "pin", "defaults": ["Shift+Escape"], "destructive": true },
    { "id": "pin.copy", "title": "Copy the pinned image", "context": "pin", "defaults": ["Ctrl+C"] },
    { "id": "pin.save", "title": "Save the pinned image", "context": "pin", "defaults": ["Ctrl+S"] },
    { "id": "pin.quick-save", "title": "Quick-save the pinned image", "context": "pin", "defaults": ["Ctrl+Shift+S"] },
    { "id": "pin.copy-text", "title": "Copy the text of a text card", "context": "pin", "defaults": ["Ctrl+Shift+C"] },
    { "id": "pin.zoom-in", "title": "Zoom in", "context": "pin", "defaults": ["Plus", "NumpadAdd"] },
    { "id": "pin.zoom-out", "title": "Zoom out", "context": "pin", "defaults": ["Minus", "NumpadSubtract"] },
    { "id": "pin.zoom-reset", "title": "Back to 100 % and fully opaque", "context": "pin", "defaults": ["0", "Numpad0"] },
    { "id": "pin.opacity-up", "title": "More opaque", "context": "pin", "defaults": ["Ctrl+Plus"] },
    { "id": "pin.opacity-down", "title": "More transparent", "context": "pin", "defaults": ["Ctrl+Minus"] },
    { "id": "pin.rotate-cw", "title": "Rotate right 90 degrees", "context": "pin", "defaults": ["1"] },
    { "id": "pin.rotate-ccw", "title": "Rotate left 90 degrees", "context": "pin", "defaults": ["2"] },
    { "id": "pin.flip-horizontal", "title": "Flip horizontally", "context": "pin", "defaults": ["3"] },
    { "id": "pin.flip-vertical", "title": "Flip vertically", "context": "pin", "defaults": ["4"] },
    { "id": "pin.move-up", "title": "Move the pin up one pixel", "context": "pin", "defaults": [{ "keys": "Up", "repeat": true }] },
    { "id": "pin.move-down", "title": "Move the pin down one pixel", "context": "pin", "defaults": [{ "keys": "Down", "repeat": true }] },
    { "id": "pin.move-left", "title": "Move the pin left one pixel", "context": "pin", "defaults": [{ "keys": "Left", "repeat": true }] },
    { "id": "pin.move-right", "title": "Move the pin right one pixel", "context": "pin", "defaults": [{ "keys": "Right", "repeat": true }] },
    { "id": "pin.thumbnail", "title": "Thumbnail mode on or off", "context": "pin", "defaults": ["T"] },
    { "id": "pin.hide", "title": "Hide the pin (show it again from the tray)", "context": "pin", "defaults": ["H"] },
    { "id": "pin.click-through", "title": "Let mouse clicks pass through the pin", "context": "pin", "defaults": ["Ctrl+Shift+T"] },
    { "id": "pin.group-new", "title": "Move the pin to a new group", "context": "pin", "defaults": [] },
    { "id": "pin.annotate", "title": "Annotate the pin", "context": "pin", "defaults": ["Space"] }
  ]
}
