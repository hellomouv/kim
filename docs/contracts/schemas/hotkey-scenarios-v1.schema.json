{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/madebymouv/kim/blob/main/docs/contracts/schemas/hotkey-scenarios-v1.schema.json",
  "title": "Hotkey conflict and override scenario (fixture), schema_version 1",
  "description": "A specification fixture (docs/HOTKEY_CONTRACT.md §15): installed tools (a manifest, by example name or inline, and an optional user layer), chords other programs already registered, an optional request, and the exact expected check report or request outcome. `cargo xtask schema-check` validates the embedded documents against kim-hotkey-manifest-v1, kim-hotkeys-v1 and hotkeys-cli-v1, then recomputes the expectation with the reference checker (xtask/src/hotkeys.rs). Conflict `message`s are not part of the expectation.",
  "type": "object",
  "required": ["schema", "schema_version", "title", "tools", "expected"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "kim.hotkey-scenario"},
    "schema_version": {"const": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["manifest", "config"],
        "additionalProperties": false,
        "properties": {
          "manifest": {
            "description": "Name of a file in examples/kim-hotkey-manifest-v1/ (without .json), or an inline manifest.",
            "oneOf": [{"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"}, {"type": "object"}]
          },
          "config": {"description": "The tool's hotkeys.json, or null when it has none.", "type": ["object", "null"]}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taken": {
          "description": "Global chords that other programs already registered (RegisterHotKey fails for them).",
          "type": "array",
          "items": {"$ref": "#/$defs/binding_syntax"}
        }
      }
    },
    "request": {
      "type": "object",
      "required": ["command", "tool", "action"],
      "additionalProperties": false,
      "properties": {
        "command": {"enum": ["set", "disable", "reset"]},
        "tool": {"$ref": "#/$defs/tool_id"},
        "action": {"$ref": "#/$defs/action_id"},
        "bindings": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}},
        "replace": {"type": "boolean"},
        "allow_conflict": {"type": "boolean"},
        "dry_run": {"type": "boolean"}
      },
      "anyOf": [
        {"properties": {"command": {"const": "set"}}, "required": ["bindings"]},
        {"properties": {"command": {"enum": ["disable", "reset"]}}, "not": {"required": ["bindings"]}}
      ]
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "required": ["report"],
          "additionalProperties": false,
          "properties": {"report": {"description": "hotkeys.check data (hotkeys-cli-v1 check_data).", "type": "object"}}
        },
        {
          "type": "object",
          "required": ["outcome", "written", "config_after", "changes", "conflicts"],
          "additionalProperties": false,
          "properties": {
            "outcome": {"const": "applied"},
            "written": {"type": "boolean"},
            "config_after": {
              "description": "The requested tool's hotkeys.json after the command (null: no file).",
              "type": ["object", "null"]
            },
            "changes": {"type": "array", "items": {"type": "object"}},
            "conflicts": {
              "description": "Every conflict involving the action afterwards (hotkeys-cli-v1 conflict).",
              "type": "array",
              "items": {"type": "object"}
            }
          }
        },
        {
          "type": "object",
          "required": ["outcome", "error", "conflicts"],
          "additionalProperties": false,
          "properties": {
            "outcome": {"const": "refused"},
            "error": {
              "type": "object",
              "required": ["code", "exit_code"],
              "additionalProperties": false,
              "properties": {
                "code": {
                  "enum": [
                    "hotkey_invalid",
                    "hotkey_reserved",
                    "action_not_found",
                    "hotkeys_invalid",
                    "hotkey_unsupported",
                    "hotkeys_from_newer_version",
                    "hotkey_conflict"
                  ]
                },
                "exit_code": {"type": "integer"}
              },
              "anyOf": [
                {"properties": {"code": {"const": "hotkey_invalid"}, "exit_code": {"const": 2}}},
                {"properties": {"code": {"const": "hotkey_reserved"}, "exit_code": {"const": 2}}},
                {"properties": {"code": {"const": "action_not_found"}, "exit_code": {"const": 3}}},
                {"properties": {"code": {"const": "hotkeys_invalid"}, "exit_code": {"const": 4}}},
                {"properties": {"code": {"const": "hotkey_unsupported"}, "exit_code": {"const": 5}}},
                {"properties": {"code": {"const": "hotkeys_from_newer_version"}, "exit_code": {"const": 5}}},
                {"properties": {"code": {"const": "hotkey_conflict"}, "exit_code": {"const": 7}}}
              ]
            },
            "conflicts": {
              "description": "The conflicts that block the change.",
              "type": "array",
              "items": {"type": "object"}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "description": "A scenario with a request expects an outcome; without one, a report.",
      "anyOf": [
        {"required": ["request"], "properties": {"expected": {"required": ["outcome"]}}},
        {"not": {"required": ["request"]}, "properties": {"expected": {"required": ["report"]}}}
      ]
    }
  ],
  "$defs": {
    "tool_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
    "action_id": {
      "description": "Stable action ID without the tool name: two to four lowercase dotted segments (HOTKEY_CONTRACT §3.1).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,3}$"
    },
    "binding_syntax": {
      "description": "Canonical binding text: one to four steps separated by one space; a step is a chord (modifiers in the order Ctrl, Alt or AltGr, Shift, Win, then a named or code: key), a char: key or an @leader (HOTKEY_CONTRACT §5.1).",
      "type": "string",
      "pattern": "^((((L|R)?Ctrl\\+)?((L|R)?Alt\\+)?|AltGr\\+)((L|R)?Shift\\+)?((L|R)?Win\\+)?([A-Z0-9]|F([1-9]|1[0-9]|2[0-4])|Escape|Tab|Enter|Space|Backspace|Insert|Delete|Home|End|PageUp|PageDown|Up|Down|Left|Right|Plus|Minus|Comma|Period|Numpad[0-9]|NumpadAdd|NumpadSubtract|NumpadMultiply|NumpadDivide|NumpadDecimal|NumpadEnter|PrintScreen|Pause|ScrollLock|ContextMenu|MediaPlayPause|MediaStop|MediaNext|MediaPrevious|VolumeUp|VolumeDown|VolumeMute|HangulMode|Hanja|KanaMode|Convert|NonConvert|code:(Key[A-Z]|Digit[0-9]|Minus|Equal|BracketLeft|BracketRight|Backslash|Semicolon|Quote|Backquote|Comma|Period|Slash|IntlBackslash|IntlRo|IntlYen|Lang[1-5]))|char:\\S|@[a-z][a-z0-9-]{0,31})( ((((L|R)?Ctrl\\+)?((L|R)?Alt\\+)?|AltGr\\+)((L|R)?Shift\\+)?((L|R)?Win\\+)?([A-Z0-9]|F([1-9]|1[0-9]|2[0-4])|Escape|Tab|Enter|Space|Backspace|Insert|Delete|Home|End|PageUp|PageDown|Up|Down|Left|Right|Plus|Minus|Comma|Period|Numpad[0-9]|NumpadAdd|NumpadSubtract|NumpadMultiply|NumpadDivide|NumpadDecimal|NumpadEnter|PrintScreen|Pause|ScrollLock|ContextMenu|MediaPlayPause|MediaStop|MediaNext|MediaPrevious|VolumeUp|VolumeDown|VolumeMute|HangulMode|Hanja|KanaMode|Convert|NonConvert|code:(Key[A-Z]|Digit[0-9]|Minus|Equal|BracketLeft|BracketRight|Backslash|Semicolon|Quote|Backquote|Comma|Period|Slash|IntlBackslash|IntlRo|IntlYen|Lang[1-5]))|char:\\S|@[a-z][a-z0-9-]{0,31})){0,3}$"
    }
  }
}
