{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/madebymouv/kim/blob/main/docs/contracts/schemas/hotkeys-cli-v1.schema.json",
  "title": "`<tool> hotkeys … --json` documents, schema_version 1",
  "description": "The cli-envelope-v1 envelope of every `hotkeys` command of every tool (docs/HOTKEY_CONTRACT.md §10), the data of each command, and the hotkey error codes with their exit codes (CLI_CONTRACT §6). Closed objects, like kim-cli-v1; consumers must still ignore unknown fields and treat unknown conflict codes by severity.",
  "oneOf": [
    {"$ref": "#/$defs/failure"},
    {"$ref": "#/$defs/ok_list"},
    {"$ref": "#/$defs/ok_show"},
    {"$ref": "#/$defs/ok_change"},
    {"$ref": "#/$defs/ok_check"},
    {"$ref": "#/$defs/ok_export"}
  ],
  "$defs": {
    "tool_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "action_id": {
      "description": "Stable action ID without the tool name: two to four lowercase dotted segments (HOTKEY_CONTRACT §3.1).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,3}$"
    },
    "name_id": {
      "description": "Identifier of a leader or a context (HOTKEY_CONTRACT §3.2, §3.3).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "binding_syntax": {
      "description": "Canonical binding text: one to four steps separated by one space; a step is a chord (modifiers in the order Ctrl, Alt or AltGr, Shift, Win, then a named or code: key), a char: key or an @leader (HOTKEY_CONTRACT §5.1).",
      "type": "string",
      "pattern": "^((((L|R)?Ctrl\\+)?((L|R)?Alt\\+)?|AltGr\\+)((L|R)?Shift\\+)?((L|R)?Win\\+)?([A-Z0-9]|F([1-9]|1[0-9]|2[0-4])|Escape|Tab|Enter|Space|Backspace|Insert|Delete|Home|End|PageUp|PageDown|Up|Down|Left|Right|Plus|Minus|Comma|Period|Numpad[0-9]|NumpadAdd|NumpadSubtract|NumpadMultiply|NumpadDivide|NumpadDecimal|NumpadEnter|PrintScreen|Pause|ScrollLock|ContextMenu|MediaPlayPause|MediaStop|MediaNext|MediaPrevious|VolumeUp|VolumeDown|VolumeMute|HangulMode|Hanja|KanaMode|Convert|NonConvert|code:(Key[A-Z]|Digit[0-9]|Minus|Equal|BracketLeft|BracketRight|Backslash|Semicolon|Quote|Backquote|Comma|Period|Slash|IntlBackslash|IntlRo|IntlYen|Lang[1-5]))|char:\\S|@[a-z][a-z0-9-]{0,31})( ((((L|R)?Ctrl\\+)?((L|R)?Alt\\+)?|AltGr\\+)((L|R)?Shift\\+)?((L|R)?Win\\+)?([A-Z0-9]|F([1-9]|1[0-9]|2[0-4])|Escape|Tab|Enter|Space|Backspace|Insert|Delete|Home|End|PageUp|PageDown|Up|Down|Left|Right|Plus|Minus|Comma|Period|Numpad[0-9]|NumpadAdd|NumpadSubtract|NumpadMultiply|NumpadDivide|NumpadDecimal|NumpadEnter|PrintScreen|Pause|ScrollLock|ContextMenu|MediaPlayPause|MediaStop|MediaNext|MediaPrevious|VolumeUp|VolumeDown|VolumeMute|HangulMode|Hanja|KanaMode|Convert|NonConvert|code:(Key[A-Z]|Digit[0-9]|Minus|Equal|BracketLeft|BracketRight|Backslash|Semicolon|Quote|Backquote|Comma|Period|Slash|IntlBackslash|IntlRo|IntlYen|Lang[1-5]))|char:\\S|@[a-z][a-z0-9-]{0,31})){0,3}$"
    },
    "chord_syntax": {
      "description": "One canonical chord without char: keys or leaders (used for leaders).",
      "type": "string",
      "pattern": "^(((L|R)?Ctrl\\+)?((L|R)?Alt\\+)?|AltGr\\+)((L|R)?Shift\\+)?((L|R)?Win\\+)?([A-Z0-9]|F([1-9]|1[0-9]|2[0-4])|Escape|Tab|Enter|Space|Backspace|Insert|Delete|Home|End|PageUp|PageDown|Up|Down|Left|Right|Plus|Minus|Comma|Period|Numpad[0-9]|NumpadAdd|NumpadSubtract|NumpadMultiply|NumpadDivide|NumpadDecimal|NumpadEnter|PrintScreen|Pause|ScrollLock|ContextMenu|MediaPlayPause|MediaStop|MediaNext|MediaPrevious|VolumeUp|VolumeDown|VolumeMute|HangulMode|Hanja|KanaMode|Convert|NonConvert|code:(Key[A-Z]|Digit[0-9]|Minus|Equal|BracketLeft|BracketRight|Backslash|Semicolon|Quote|Backquote|Comma|Period|Slash|IntlBackslash|IntlRo|IntlYen|Lang[1-5]))$"
    },
    "trigger": {"enum": ["press", "release", "hold"]},
    "scope_string": {
      "description": "`global`, `app` or `context:<id>`.",
      "type": "string",
      "pattern": "^(global|app|context:[a-z][a-z0-9-]{0,31})$"
    },
    "action_ref": {
      "description": "An action ID, or `@<leader>` for a leader.",
      "type": "string",
      "pattern": "^(@[a-z][a-z0-9-]{0,31}|[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,3})$"
    },
    "conflict": {
      "description": "One conflict (HOTKEY_CONTRACT §9.3–§9.5). The subject is described by tool/action/keys/scope/source; `with` is the other side.",
      "type": "object",
      "required": ["code", "severity", "tool", "action", "keys", "scope", "source", "with", "offers"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "os_reserved",
            "kim_reserved",
            "ime_reserved",
            "invalid_binding",
            "duplicate_binding",
            "sequence_prefix",
            "cross_tool_global",
            "global_shadows_app",
            "taken",
            "hook_overrides_global",
            "os_shortcut",
            "altgr_collision",
            "ime_toggle",
            "unknown_action",
            "context_override",
            "default_suppressed",
            "shadows_terminal_input"
          ]
        },
        "severity": {"enum": ["error", "warning", "info"]},
        "reason": {
          "enum": [
            "scope_not_allowed",
            "backend_unsupported",
            "trigger_unsupported",
            "unknown_leader",
            "not_bindable"
          ]
        },
        "tool": {"$ref": "#/$defs/tool_id"},
        "action": {"$ref": "#/$defs/action_ref"},
        "keys": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binding_syntax"}]},
        "scope": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/scope_string"}]},
        "source": {"enum": ["default", "user", "profile"]},
        "with": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["tool", "action", "keys", "scope"],
              "additionalProperties": false,
              "properties": {
                "tool": {"$ref": "#/$defs/tool_id"},
                "action": {"$ref": "#/$defs/action_ref"},
                "keys": {"$ref": "#/$defs/binding_syntax"},
                "scope": {"$ref": "#/$defs/scope_string"}
              }
            },
            {
              "type": "object",
              "required": ["reserved", "keys", "name"],
              "additionalProperties": false,
              "properties": {
                "reserved": {"enum": ["os", "kim", "ime", "emergency"]},
                "keys": {"$ref": "#/$defs/binding_syntax"},
                "name": {"type": "string", "minLength": 1}
              }
            },
            {
              "type": "object",
              "required": ["other_program", "keys"],
              "additionalProperties": false,
              "properties": {"other_program": {"const": true}, "keys": {"$ref": "#/$defs/binding_syntax"}}
            }
          ]
        },
        "offers": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "keys"],
                "additionalProperties": false,
                "properties": {"kind": {"const": "rebind"}, "keys": {"$ref": "#/$defs/binding_syntax"}}
              },
              {
                "type": "object",
                "required": ["kind"],
                "additionalProperties": false,
                "properties": {"kind": {"enum": ["disable", "keep", "reset"]}}
              }
            ]
          }
        },
        "message": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "description": "The severity of each code is fixed.",
          "anyOf": [
            {
              "properties": {
                "code": {
                  "enum": [
                    "os_reserved",
                    "kim_reserved",
                    "ime_reserved",
                    "invalid_binding",
                    "duplicate_binding",
                    "sequence_prefix",
                    "cross_tool_global"
                  ]
                },
                "severity": {"const": "error"}
              }
            },
            {
              "properties": {
                "code": {
                  "enum": [
                    "global_shadows_app",
                    "taken",
                    "hook_overrides_global",
                    "os_shortcut",
                    "altgr_collision",
                    "ime_toggle",
                    "unknown_action"
                  ]
                },
                "severity": {"const": "warning"}
              }
            },
            {
              "properties": {
                "code": {"enum": ["context_override", "default_suppressed", "shadows_terminal_input"]},
                "severity": {"const": "info"}
              }
            }
          ]
        },
        {
          "description": "`reason` is present exactly for invalid_binding.",
          "anyOf": [
            {"required": ["reason"], "properties": {"code": {"const": "invalid_binding"}}},
            {"not": {"required": ["reason"]}, "properties": {"code": {"not": {"const": "invalid_binding"}}}}
          ]
        }
      ]
    },
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "layer_state": {
      "type": "object",
      "required": ["source", "bindings"],
      "additionalProperties": false,
      "properties": {
        "source": {"enum": ["default", "user", "disabled"]},
        "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding_syntax"}}
      }
    },
    "change": {
      "type": "object",
      "required": ["action", "before", "after"],
      "additionalProperties": false,
      "properties": {
        "action": {"$ref": "#/$defs/action_ref"},
        "before": {"$ref": "#/$defs/layer_state"},
        "after": {"$ref": "#/$defs/layer_state"}
      }
    },
    "binding_view": {
      "type": "object",
      "required": ["keys", "scope", "trigger", "active", "registration"],
      "additionalProperties": false,
      "properties": {
        "keys": {"$ref": "#/$defs/binding_syntax"},
        "scope": {"$ref": "#/$defs/scope_string"},
        "trigger": {"$ref": "#/$defs/trigger"},
        "active": {"type": "boolean"},
        "registration": {"enum": ["registered", "taken", "not_running", "unknown", "not_applicable"]}
      }
    },
    "action_view": {
      "type": "object",
      "required": ["id", "title", "scope", "bindable", "source", "defaults", "bindings"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/action_id"},
        "title": {"type": "string", "minLength": 1},
        "scope": {"$ref": "#/$defs/scope_string"},
        "bindable": {"type": "boolean"},
        "source": {"enum": ["default", "user", "profile", "disabled", "unbound", "reserved"]},
        "defaults": {"type": "array", "items": {"$ref": "#/$defs/binding_syntax"}},
        "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding_view"}}
      }
    },
    "list_data": {
      "type": "object",
      "required": ["tool", "enabled", "config", "disabled_scopes", "leaders", "actions"],
      "additionalProperties": false,
      "properties": {
        "tool": {"$ref": "#/$defs/tool_id"},
        "enabled": {"type": "boolean"},
        "config": {
          "type": "object",
          "required": ["path", "state"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "state": {"enum": ["default", "user", "invalid", "newer_version"]}
          }
        },
        "disabled_scopes": {"type": "array", "items": {"enum": ["global", "app", "context"]}},
        "leaders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "keys", "source"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/name_id"},
              "keys": {"$ref": "#/$defs/chord_syntax"},
              "source": {"enum": ["default", "user"]}
            }
          }
        },
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action_view"}}
      }
    },
    "show_data": {
      "type": "object",
      "required": ["tool", "action", "conflicts"],
      "additionalProperties": false,
      "properties": {
        "tool": {"$ref": "#/$defs/tool_id"},
        "action": {"$ref": "#/$defs/action_view"},
        "conflicts": {"$ref": "#/$defs/conflicts"}
      }
    },
    "change_data": {
      "type": "object",
      "required": ["tool", "dry_run", "written", "path", "changes", "conflicts"],
      "additionalProperties": false,
      "properties": {
        "tool": {"$ref": "#/$defs/tool_id"},
        "dry_run": {"type": "boolean"},
        "written": {"type": "boolean"},
        "path": {"type": "string", "minLength": 1},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
        "conflicts": {"$ref": "#/$defs/conflicts"}
      }
    },
    "check_data": {
      "type": "object",
      "required": ["tools", "conflicts", "summary"],
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "version", "source", "enabled"],
            "additionalProperties": false,
            "properties": {
              "tool": {"$ref": "#/$defs/tool_id"},
              "version": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/semver"}]},
              "source": {"enum": ["self", "manifest"]},
              "enabled": {"type": "boolean"}
            }
          }
        },
        "conflicts": {"$ref": "#/$defs/conflicts"},
        "summary": {
          "type": "object",
          "required": ["errors", "warnings", "infos"],
          "additionalProperties": false,
          "properties": {
            "errors": {"type": "integer", "minimum": 0},
            "warnings": {"type": "integer", "minimum": 0},
            "infos": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "export_data": {
      "type": "object",
      "required": ["tool", "path", "document"],
      "additionalProperties": false,
      "properties": {
        "tool": {"$ref": "#/$defs/tool_id"},
        "path": {"type": "string", "minLength": 1},
        "document": {
          "type": "object",
          "required": ["schema", "schema_version", "tool"],
          "properties": {"schema": {"const": "kim.hotkeys"}, "schema_version": {"const": 1}}
        }
      }
    },
    "failure": {
      "type": "object",
      "required": ["ok", "command", "schema_version", "error"],
      "additionalProperties": false,
      "properties": {
        "ok": {"const": false},
        "command": {"type": "string", "pattern": "^([a-z][a-z0-9-]{1,31}|hotkeys(\\.[a-z]+)?)$"},
        "schema_version": {"const": 1},
        "error": {
          "type": "object",
          "required": ["code", "exit_code", "message", "hint", "details"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "hotkey_invalid",
                "hotkey_reserved",
                "action_not_found",
                "hotkeys_invalid",
                "hotkey_unsupported",
                "hotkeys_from_newer_version",
                "hotkey_conflict",
                "io",
                "internal",
                "permission_denied",
                "usage",
                "not_installed",
                "confirmation_required",
                "cancelled"
              ]
            },
            "exit_code": {"type": "integer"},
            "message": {"type": "string", "minLength": 1},
            "hint": {"type": ["string", "null"]},
            "details": {"type": "array", "items": {"type": "string"}}
          },
          "anyOf": [
            {"properties": {"code": {"const": "hotkey_invalid"}, "exit_code": {"const": 2}}},
            {"properties": {"code": {"const": "hotkey_reserved"}, "exit_code": {"const": 2}}},
            {"properties": {"code": {"const": "action_not_found"}, "exit_code": {"const": 3}}},
            {"properties": {"code": {"const": "hotkeys_invalid"}, "exit_code": {"const": 4}}},
            {"properties": {"code": {"const": "hotkey_unsupported"}, "exit_code": {"const": 5}}},
            {"properties": {"code": {"const": "hotkeys_from_newer_version"}, "exit_code": {"const": 5}}},
            {"properties": {"code": {"const": "hotkey_conflict"}, "exit_code": {"const": 7}}},
            {"properties": {"code": {"const": "io"}, "exit_code": {"const": 1}}},
            {"properties": {"code": {"const": "internal"}, "exit_code": {"const": 1}}},
            {"properties": {"code": {"const": "permission_denied"}, "exit_code": {"const": 1}}},
            {"properties": {"code": {"const": "usage"}, "exit_code": {"const": 2}}},
            {"properties": {"code": {"const": "not_installed"}, "exit_code": {"const": 3}}},
            {"properties": {"code": {"const": "confirmation_required"}, "exit_code": {"const": 7}}},
            {"properties": {"code": {"const": "cancelled"}, "exit_code": {"const": 8}}}
          ]
        }
      }
    },
    "ok_list": {
      "type": "object",
      "required": ["ok", "command", "schema_version", "data", "warnings"],
      "additionalProperties": false,
      "properties": {
        "ok": {"const": true},
        "command": {"enum": ["hotkeys.list"]},
        "schema_version": {"const": 1},
        "data": {"$ref": "#/$defs/list_data"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ok_show": {
      "type": "object",
      "required": ["ok", "command", "schema_version", "data", "warnings"],
      "additionalProperties": false,
      "properties": {
        "ok": {"const": true},
        "command": {"enum": ["hotkeys.show"]},
        "schema_version": {"const": 1},
        "data": {"$ref": "#/$defs/show_data"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ok_change": {
      "type": "object",
      "required": ["ok", "command", "schema_version", "data", "warnings"],
      "additionalProperties": false,
      "properties": {
        "ok": {"const": true},
        "command": {"enum": ["hotkeys.set", "hotkeys.disable", "hotkeys.enable", "hotkeys.reset", "hotkeys.import"]},
        "schema_version": {"const": 1},
        "data": {"$ref": "#/$defs/change_data"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ok_check": {
      "type": "object",
      "required": ["ok", "command", "schema_version", "data", "warnings"],
      "additionalProperties": false,
      "properties": {
        "ok": {"const": true},
        "command": {"enum": ["hotkeys.check"]},
        "schema_version": {"const": 1},
        "data": {"$ref": "#/$defs/check_data"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ok_export": {
      "type": "object",
      "required": ["ok", "command", "schema_version", "data", "warnings"],
      "additionalProperties": false,
      "properties": {
        "ok": {"const": true},
        "command": {"enum": ["hotkeys.export"]},
        "schema_version": {"const": 1},
        "data": {"$ref": "#/$defs/export_data"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
