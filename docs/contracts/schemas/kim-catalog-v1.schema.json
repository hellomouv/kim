{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/madebymouv/kim/docs/contracts/schemas/kim-catalog-v1.schema.json",
  "title": "Kim tool catalog, schema version 1",
  "description": "Shape of catalog.json (docs/CATALOG_FORMAT.md). Kim additionally enforces semantic rules (unique ids/versions/targets, SemVer, dependency targets, safe entrypoints, expiry after generation) and verifies the detached ed25519 signature.",
  "type": "object",
  "required": ["schema", "schema_version", "catalog_version", "generated_at", "expires_at", "publisher", "tools"],
  "properties": {
    "schema": { "const": "kim.catalog" },
    "schema_version": { "const": 1 },
    "catalog_version": { "type": "integer", "minimum": 1 },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "publisher": { "type": "string", "minLength": 1 },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } }
  },
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "tool_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "tool": {
      "type": "object",
      "required": ["id", "name", "summary", "description", "license", "support", "releases"],
      "properties": {
        "id": { "$ref": "#/$defs/tool_id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string" },
        "homepage": { "type": "string", "pattern": "^https://" },
        "license": { "type": "string", "minLength": 1 },
        "support": { "enum": ["stable", "preview", "in-development", "deprecated"] },
        "releases": { "type": "array", "items": { "$ref": "#/$defs/release" } },
        "features": {
          "description": "Optional (Step 47): short feature summaries, one line each.",
          "type": "array", "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "runs": {
          "description": "Optional (Step 47): how the program runs. Known values: on-demand, window, tray, host; Kim shows other values as they are.",
          "$ref": "#/$defs/word"
        },
        "entry_points": {
          "description": "Optional (Step 47): GUI, headless CLI and MCP entry points. A tool without releases may only declare planned ones.",
          "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/entry_point" }
        },
        "links": {
          "description": "Optional (Step 47): documentation and integration guides.",
          "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/link" }
        },
        "shortcuts": { "$ref": "#/$defs/shortcuts" },
        "permissions": {
          "description": "Optional (Step 47): security-relevant capabilities, disclosed before every install. Known ids: global-hotkeys, keyboard-hook, screen-capture, clipboard, input-injection, launch-programs, window-control, autostart, network.",
          "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/permission" }
        }
      }
    },
    "word": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "entry_point": {
      "type": "object",
      "required": ["kind", "command", "summary", "status"],
      "properties": {
        "kind": { "description": "gui, cli (headless: never opens a window) or mcp", "$ref": "#/$defs/word" },
        "command": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
        "status": { "enum": ["available", "planned"] }
      }
    },
    "link": {
      "type": "object",
      "required": ["kind", "title", "url"],
      "properties": {
        "kind": { "description": "docs, mcp, shortcuts, source, ...", "$ref": "#/$defs/word" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "type": "string", "pattern": "^https://." }
      }
    },
    "shortcuts": {
      "description": "Optional (Step 47): a summary of the tool's hotkey manifest (HOTKEY_CONTRACT §3.4). For an installed tool Kim shows the installed manifest instead.",
      "type": "object",
      "required": ["manifest", "backend", "actions"],
      "properties": {
        "manifest": { "type": "string", "pattern": "^[^/\\\\:]+\\.json$" },
        "backend": { "description": "focus, register or hook (HOTKEY_CONTRACT §4.2)", "$ref": "#/$defs/word" },
        "actions": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["action", "title", "scope"],
            "properties": {
              "action": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,3}$" },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "scope": { "type": "string", "pattern": "^(global|app|context:[a-z][a-z0-9-]{0,31})$" },
              "keys": { "type": "array", "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
              "bindable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "permission": {
      "type": "object",
      "required": ["id", "detail"],
      "properties": {
        "id": { "$ref": "#/$defs/word" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 200 },
        "opt_in": { "type": "boolean" }
      }
    },
    "release": {
      "type": "object",
      "required": ["version", "channel", "published_at", "release_notes", "assets"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "channel": { "enum": ["stable", "preview"] },
        "published_at": { "$ref": "#/$defs/timestamp" },
        "release_notes": { "type": "string" },
        "min_kim_version": { "$ref": "#/$defs/semver" },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "version_req"],
            "properties": {
              "tool": { "$ref": "#/$defs/tool_id" },
              "version_req": { "type": "string", "minLength": 1 }
            }
          }
        },
        "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }
      }
    },
    "asset": {
      "type": "object",
      "required": ["os", "arch", "url", "size", "sha256", "kind", "entrypoint"],
      "properties": {
        "os": { "enum": ["windows", "linux"] },
        "arch": { "enum": ["x86_64", "aarch64"] },
        "min_os_build": { "type": "integer", "minimum": 0 },
        "url": { "type": "string", "pattern": "^(https://.+|http://(127\\.0\\.0\\.1|localhost|\\[::1\\])([:/].*)?)$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "kind": { "enum": ["zip", "exe"] },
        "entrypoint": { "type": "string", "minLength": 1 }
      }
    }
  }
}
